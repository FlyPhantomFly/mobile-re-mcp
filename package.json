    "pentest",
    "reverse-engineering",
    "firebase",
    "secrets-detection",
    "static-analysis",
    "claude",
    "ai"
  ],
  "author": "FlyPhantomFly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlyPhantomFly/mobile-re-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/FlyPhantomFly/mobile-re-mcp/issues"
  },
  "homepage": "https://github.com/FlyPhantomFly/mobile-re-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "adm-zip": "^0.6.0",
    "plist": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.6.6",
    "@types/plist": "^3.0.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
