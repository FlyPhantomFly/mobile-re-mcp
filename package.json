{
  "name": "mobile-re-mcp",
  "version": "1.2.2",
  "description": "Mobile app security analysis MCP server for Android APK and iOS IPA files",
  "bin": {
    "mobile-re-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "test:tools": "node test-tools.mjs",
    "prepare": "npm run build"
